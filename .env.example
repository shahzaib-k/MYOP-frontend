# Copy to .env and point at your running backend.
#
# Metro only inlines variables prefixed with EXPO_PUBLIC_, and it reads .env at
# bundler start — restart `npm start` after changing this.
#
# Android emulator .......... http://10.0.2.2:5000
# iOS simulator / web ....... http://localhost:5000
# Physical device (Expo Go) .. http://<your-computer-LAN-IP>:5000
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
