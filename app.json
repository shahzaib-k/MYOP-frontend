{
  "expo": {
    "name": "Make Your Own Platter",
    "slug": "myop",
    "scheme": "myop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fyp.makeyourownplatter"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF1EB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.fyp.makeyourownplatter",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF1EB"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#FF5A1F",
          "defaultChannel": "default"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.fyp.makeyourownplatter",
          "enableGooglePay": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "878e1fd4-cac1-4d64-82ab-6de79bc0e4dc"
      }
    },
    "owner": "shahzaib-112s-team"
  }
}
